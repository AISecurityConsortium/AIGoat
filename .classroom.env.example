# Copy to .classroom.env (gitignored) and set your assigned ngrok domain.
# Do NOT put your ngrok authtoken here. Configure the token with:
#   ngrok config add-authtoken <token>
#
# Optional host Ollama overrides (defaults use Windows/host Ollama on localhost):
# CLASSROOM_OLLAMA_URL=http://127.0.0.1:11434
# CLASSROOM_OLLAMA_MODEL=tinyllama

NGROK_DOMAIN=replace-with-assigned-domain.ngrok-free.app
